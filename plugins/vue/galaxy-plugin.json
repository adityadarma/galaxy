{
  "id": "vue-language-server",
  "name": "Vue Language Server",
  "version": "2.2.12",
  "description": "Vue single-file components (Volar). Installs into the plugin folder with npm and runs with its own TypeScript.",
  "languages": ["vue"],
  "server": {
    "command": ["${pluginDir}/node_modules/.bin/vue-language-server"],
    "args": ["--stdio"],
    "initializationOptions": {
      "vue": { "hybridMode": false },
      "typescript": { "tsdk": "${pluginDir}/node_modules/typescript/lib" }
    }
  },
  "install": {
    "steps": [
      ["npm", "install", "--prefix", "${pluginDir}", "--no-audit", "--no-fund", "--loglevel=error", "typescript@5.9.3", "@vue/language-server@2.2.12"]
    ]
  }
}
