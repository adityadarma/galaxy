{
  "id": "typescript-language-server",
  "name": "TypeScript Language Server",
  "version": "6.0.2",
  "description": "TypeScript and JavaScript. Installs into the plugin folder with npm.",
  "languages": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
  "server": {
    "command": ["${pluginDir}/node_modules/.bin/typescript-language-server"],
    "args": ["--stdio"]
  },
  "install": {
    "steps": [
      ["npm", "install", "--prefix", "${pluginDir}", "--no-audit", "--no-fund", "--loglevel=error", "typescript@6.0.3", "typescript-language-server@6.0.2"]
    ]
  }
}
