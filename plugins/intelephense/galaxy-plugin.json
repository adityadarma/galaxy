{
  "id": "intelephense",
  "name": "Intelephense",
  "version": "1.18.5",
  "description": "PHP language server. Installs into the plugin folder with npm.",
  "languages": ["php", "blade"],
  "priority": 10,
  "server": {
    "command": ["${pluginDir}/node_modules/.bin/intelephense"],
    "args": ["--stdio"]
  },
  "install": {
    "steps": [
      ["npm", "install", "--prefix", "${pluginDir}", "--no-audit", "--no-fund", "--loglevel=error", "intelephense@1.18.5"]
    ]
  }
}
